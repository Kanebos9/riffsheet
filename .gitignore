# Build output — regenerated by scripts/build.sh and npm run build. Never committed:
# shell/build alone is 433 MB.
shell/build/
shell/build-ninja/
shell/build_tests/
webcore/dist/
webcore/dist-spike/
pipeline/dist/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CMakeUserPresets.json

# Locally staged release packages. GitHub Actions publishes its own copies.
/Riffsheet-*/
/Riffsheet-*.zip

# Dependencies — restored by `npm ci` from the lockfiles, which ARE committed.
node_modules/

# Local Python environments and caches. MuScriptor is installed outside this repo.
.venv/
venv/
__pycache__/
*.py[cod]

# Operating systems and editors
.DS_Store
._*
Thumbs.db
Desktop.ini
desktop.ini
*.swp
*.suo
*.user
.idea/
.vscode/
.vs/

# Local machine settings that would be wrong on anyone else's computer.
*.local
.env
.env.*
!.env.example

# Test and scratch output
/tmp/
*.log
*.ips
coverage/
webcore/verify-output/
webcore/spike-results/

# Private working notes and one-off local evidence. None is needed to build or test.
/HANDOFF-CODEX.md
/HANDOFF-FABLE.md
/opus review.md
/IDEAS.md
/MORNING.md
/PLAN.md
/PROJECT.md
/E1-clip.wav
/integration-evidence/

# alphaTab supplies these at build time. Do not recommit duplicate generated assets.
/webcore/public/font/
/webcore/public/soundfont/
