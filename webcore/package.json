{
  "name": "riffsheet-webcore",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Riffsheet web core — tri-view (staff + note names + tab) UI, rendering and editing. Runs in a JUCE WebView or a plain browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && node scripts/verify.mjs",
    "test:midi-import": "node scripts/run-ts-tests.mjs scripts/midi-import-test.ts",
    "test:grand-staff": "node scripts/run-ts-tests.mjs scripts/grand-staff-test.ts",
    "test:sampler-loop": "node scripts/run-ts-tests.mjs scripts/sampler-loop-test.ts",
    "test:transport-clock": "node scripts/run-ts-tests.mjs scripts/transport-clock-test.ts",
    "test:roll-snap": "node scripts/run-ts-tests.mjs scripts/roll-snap-test.ts",
    "test:riffsheet-doc": "node scripts/run-ts-tests.mjs scripts/riffsheet-doc-test.ts",
    "test:view-units": "node scripts/run-ts-tests.mjs scripts/view-units-test.ts",
    "test:parts": "node scripts/run-ts-tests.mjs scripts/parts-test.ts",
    "test:gesture": "node scripts/run-ts-tests.mjs scripts/gesture-test.ts",
    "test:edit-units": "node scripts/run-ts-tests.mjs src/edit/cuts.test.ts src/edit/editBrain.test.ts src/edit/performanceEdit.test.ts src/edit/ripple.test.ts",
    "probe:ripple": "node scripts/ripple-probe.mjs",
    "test:ui-units": "node scripts/run-ts-tests.mjs src/ui/theme.test.ts",
    "test:seam-units": "node scripts/run-ts-tests.mjs src/app/identity.test.ts src/edit/chordEvents.test.ts",
    "probe:sheet-edit": "node scripts/sheet-edit-probe.mjs",
    "probe:seam": "node scripts/seam-probe.mjs",
    "test:regressions": "node scripts/run-ts-tests.mjs scripts/midi-import-test.ts scripts/grand-staff-test.ts scripts/sampler-loop-test.ts scripts/transport-clock-test.ts scripts/roll-snap-test.ts scripts/riffsheet-doc-test.ts scripts/view-units-test.ts scripts/parts-test.ts scripts/gesture-test.ts src/ui/theme.test.ts src/app/identity.test.ts src/edit/chordEvents.test.ts",
    "build:debug": "RIFFSHEET_SOURCEMAP=1 vite build"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
